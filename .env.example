# Cloud STT (optional)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
WHISPER_DEVICE=auto

# Cloud LoRA: stub (lifecycle dry-run) | modal | hf_jobs | runpod
CLOUD_FINETUNE_BACKEND=stub
CLOUD_FINETUNE_TOKEN=
CLOUD_FINETUNE_ENDPOINT=

# Dataset vault client (copy secrets from envs/.env)
VAULT_ENDPOINT=http://127.0.0.1:9000
VAULT_ACCESS_KEY=stt_vault_app
VAULT_SECRET_KEY=
VAULT_BUCKET=stt-datasets
VAULT_SECURE=false
