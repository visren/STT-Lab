# Cloud STT (optional — also configurable in the web Settings UI)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
WHISPER_DEVICE=auto

# Future cloud LoRA backends (not implemented yet)
CLOUD_FINETUNE_BACKEND=
CLOUD_FINETUNE_TOKEN=

# Dataset vault (from envs/.env — host client defaults)
VAULT_ENDPOINT=http://127.0.0.1:9000
VAULT_ACCESS_KEY=stt_vault_app
VAULT_SECRET_KEY=
VAULT_BUCKET=stt-datasets
VAULT_SECURE=false

# Web UI talks to API at http://127.0.0.1:8000 (see apps/web next.config.ts)
