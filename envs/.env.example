# Copy to envs/.env and set strong secrets before starting the vault.
#   cp envs/.env.example envs/.env

VAULT_ROOT_USER=stt_vault_admin
# Use hex/alphanumeric secrets (avoid leading '-' — breaks MinIO mc CLI flags)
VAULT_ROOT_PASSWORD=change_me_root_password_hex
VAULT_ACCESS_KEY=stt_vault_app
VAULT_SECRET_KEY=change_me_app_secret_hex
VAULT_BUCKET=stt-datasets
VAULT_API_PORT=9000
VAULT_CONSOLE_PORT=9001
# Optional local KMS for sse-s3: keyname:$(openssl rand -base64 32)
VAULT_KMS_SECRET_KEY=

# Host-side client (notebook / local python) talks to published ports:
VAULT_ENDPOINT=http://127.0.0.1:9000
VAULT_SECURE=false

WHISPER_DEVICE=cpu
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
