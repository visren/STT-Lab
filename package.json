{
  "name": "stt-lab",
  "private": true,
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "cd apps/api && .venv/bin/uvicorn app.main:app --reload --port 8000",
    "dev:notebook": "cd notebooks && ../apps/api/.venv/bin/jupyter lab stt_lab.ipynb",
    "build:web": "npm --prefix apps/web run build",
    "lint:web": "npm --prefix apps/web run lint"
  }
}
